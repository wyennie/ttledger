<%= form_with(model: [@campaign, @entity]) do |f| %>
  <%= render 'shared/error_messages', object: @entity %>

  <div class="form-field">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, required: true, class: "form-input" %>
  </div>

  <div class="form-field">
    <%= f.label :entity_kind_id, "Kind", class: "form-label" %>
    <%= f.collection_select :entity_kind_id,
        @campaign.entity_kinds.order(:name),
        :id, :name,
        { include_blank: "Select a kind…" },
        { class: "form-select", required: true } %>
    <p class="form-field__hint">
      <%= link_to "Manage kinds", campaign_entity_kinds_path(@campaign), style: "text-decoration: underline;" %>
    </p>
  </div>

  <div class="form-field">
    <%= f.label :summary, class: "form-label" %>
    <p class="form-field__hint" style="margin-bottom: 0.25rem;">Short blurb always passed to the AI when this entity is mentioned in chat.</p>
    <%= f.text_area :summary, rows: 3, class: "form-textarea" %>
  </div>

  <div class="form-field">
    <%= f.label :bio_page_id, "Bio page (optional)", class: "form-label" %>
    <%= f.collection_select :bio_page_id,
        @campaign.pages.order(:title),
        :id, :title,
        { include_blank: "No bio page" },
        { class: "form-select" } %>
  </div>

  <div class="form-actions">
    <%= f.submit class: "btn" %>
    <%= link_to "Cancel", campaign_entities_path(@campaign), class: "btn btn--secondary" %>
  </div>
<% end %>
