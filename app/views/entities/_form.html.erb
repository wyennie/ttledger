<%= form_with(model: [@campaign, @entity]) do |f| %>
  <%= render 'shared/error_messages', object: @entity %>

  <div class="mb-4">
    <%= f.label :name, class: "block text-lg font-medium" %>
    <%= f.text_field :name,
        required: true,
        class: "mt-1 block w-full p-2 border border-gray-600 rounded-lg focus:ring-gray-300 focus:border-gray-300" %>
  </div>

  <div class="mb-4">
    <%= f.label :entity_kind_id, "Kind", class: "block text-lg font-medium" %>
    <%= f.collection_select :entity_kind_id,
        @campaign.entity_kinds.order(:name),
        :id, :name,
        { include_blank: "Select a kind…" },
        { class: "mt-1 block w-full p-2 border border-gray-600 rounded-lg focus:ring-gray-300 focus:border-gray-300", required: true } %>
    <p class="text-sm text-gray-600 mt-1">
      <%= link_to "Manage kinds", campaign_entity_kinds_path(@campaign), class: "underline" %>
    </p>
  </div>

  <div class="mb-4">
    <%= f.label :summary, class: "block text-lg font-medium" %>
    <p class="text-sm text-gray-600 mb-1">Short blurb always passed to the AI when this entity is mentioned in chat.</p>
    <%= f.text_area :summary,
        rows: 3,
        class: "mt-1 block w-full p-2 border border-gray-600 rounded-lg focus:ring-gray-300 focus:border-gray-300" %>
  </div>

  <div class="mb-4">
    <%= f.label :bio_page_id, "Bio page (optional)", class: "block text-lg font-medium" %>
    <%= f.collection_select :bio_page_id,
        @campaign.pages.order(:title),
        :id, :title,
        { include_blank: "No bio page" },
        { class: "mt-1 block w-full p-2 border border-gray-600 rounded-lg focus:ring-gray-300 focus:border-gray-300" } %>
  </div>

  <div class="flex gap-2">
    <%= f.submit class: "py-2 px-4 bg-gray-300 font-semibold rounded-lg shadow-md hover:bg-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:ring-opacity-75" %>
    <%= link_to "Cancel", campaign_entities_path(@campaign),
        class: "py-2 px-4 font-semibold rounded-lg border border-gray-400 hover:bg-gray-100" %>
  </div>
<% end %>
