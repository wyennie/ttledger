<%= content_for :title, "Edit #{@entity.name} — #{@campaign.name}" %>

<div class="max-w-2xl mx-auto p-6">
  <%= render partial: "layouts/flash" %>
  <h1 class="text-3xl font-bold mb-4"><%= @entity.name %></h1>
  <div class="bg-gray-200 p-6 rounded-lg shadow-lg">
    <%= render "form" %>
  </div>

  <% if @entity.pages_mentioning.any? %>
    <section class="mt-8">
      <h2 class="text-xl font-semibold mb-2">Mentioned on <%= pluralize(@entity.pages_mentioning.count, "page") %></h2>
      <ul class="list-disc pl-5">
        <% @entity.pages_mentioning.distinct.order(:title).each do |page| %>
          <li><%= link_to page.title, campaign_page_path(@campaign, page), class: "underline" %></li>
        <% end %>
      </ul>
    </section>
  <% end %>
</div>
