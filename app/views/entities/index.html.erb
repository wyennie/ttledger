<%= content_for :title, "Entities — #{@campaign.name}" %>

<div class="app-grid">
  <aside class="app-grid__sidebar">
    <%= render "pages/sidebar" %>
  </aside>

  <main class="app-grid__main">
    <div class="container-medium">
      <%= render partial: "layouts/flash" %>

      <div class="page-toolbar">
        <h1>Entities</h1>
        <div class="page-toolbar__actions">
          <%= link_to "Manage kinds", campaign_entity_kinds_path(@campaign), class: "btn btn--secondary" %>
          <%= link_to "+ New entity", new_campaign_entity_path(@campaign), class: "btn" %>
        </div>
      </div>

  <% if @entities.empty? %>
    <div class="empty-state">
      <span class="empty-state__symbol">❦</span>
      <p>No entities yet. Create characters, locations, factions and more, then mention them with <code>@</code> in any page.</p>
    </div>
  <% else %>
    <% @grouped.each do |kind_name, entities| %>
      <section class="section">
        <h2 class="section__heading"><%= kind_name %></h2>
        <ul class="item-list item-list--plain">
          <% entities.each do |entity| %>
            <li class="item-list__row">
              <div class="item-list__main">
                <%= link_to entity.name, edit_campaign_entity_path(@campaign, entity), class: "item-list__title" %>
                <% if entity.summary.present? %>
                  <p class="item-list__sub"><%= entity.summary %></p>
                <% end %>
                <% if entity.bio_page %>
                  <p class="item-list__sub item-list__sub--xs">Bio: <%= link_to entity.bio_page.title, campaign_page_path(@campaign, entity.bio_page) %></p>
                <% end %>
              </div>
              <%= button_to "Delete", campaign_entity_path(@campaign, entity),
                  method: :delete,
                  data: { turbo_confirm: "Delete #{entity.name}? This will remove all mentions of them." },
                  class: "btn btn--link" %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  <% end %>
    </div>
  </main>
</div>
