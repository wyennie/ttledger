<div class="chat-navigation">
  <%= button_to "Start a new conversation to keep her awake...", chats_path, method: :post, class: "chat-navigation__new" %>

  <% @chats.each do |chat| %>
    <%= link_to chat.messages[0]&.content&.truncate_words(16), chat_path(chat), class: "chat-navigation__entry" %>
  <% end %>
</div>
