<% require "redcarpet" %>
<div id="<%= dom_id(message) %>_messages">
  <% if message.user? %>
    <div class="message message--user">
      <%= simple_format message.content %>
    </div>
  <% elsif message.system? %>
  <% else %>
    <div class="markdown message message--assistant">
      <%= simple_format render_markdown(message.content) %>
    </div>
  <% end %>
</div>
