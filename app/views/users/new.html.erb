<div class="auth-frame">
<h1 class="form-page-title">Sign Up</h1>
<div class="form-card form-card--narrow">
  <%= form_with(model: @user) do |f| %>
    <%= render 'shared/error_messages', object: @user %>

    <div class="form-field">
      <%= f.label :username, class: "form-label" %>
      <%= f.text_field :username, class: "form-input" %>
    </div>

    <div class="form-field">
      <%= f.label :name, class: "form-label" %>
      <%= f.text_field :name, class: "form-input" %>
    </div>

    <div class="form-field">
      <%= f.label :email, class: "form-label" %>
      <%= f.email_field :email, class: "form-input" %>
    </div>

    <div class="form-field">
      <%= f.label :password, class: "form-label" %>
      <%= f.password_field :password, class: "form-input" %>
    </div>

    <div class="form-field">
      <%= f.label :password_confirmation, "Confirmation", class: "form-label" %>
      <%= f.password_field :password_confirmation, class: "form-input" %>
    </div>

    <div>
      <%= f.submit "Create account", class: "btn btn--full btn--primary" %>
    </div>
  <% end %>
</div>
</div>
