
<h1 class="form-page-title">Edit</h1>

<div class="form-card form-card--narrow">
  <%= form_with(model: @user) do |f| %>
    <%= render 'shared/error_messages', object: @user %>

    <div class="form-field">
      <%= f.label :username, class: "form-label" %>
      <%= f.text_field :username, class: "form-input" %>
    </div>

    <div class="form-field">
      <%= f.label :name, class: "form-label" %>
      <%= f.text_field :name, class: "form-input" %>
    </div>

    <div class="form-field">
      <%= f.label :email, class: "form-label" %>
      <%= f.email_field :email, class: "form-input" %>
    </div>

    <div class="form-field">
      <%= f.label :password, class: "form-label" %>
      <%= f.password_field :password, class: "form-input" %>
    </div>

    <div class="form-field">
      <%= f.label :password_confirmation, "Confirmation", class: "form-label" %>
      <%= f.password_field :password_confirmation, class: "form-input" %>
    </div>

    <div>
      <%= f.submit "Save changes", class: "btn btn--full" %>
    </div>
  <% end %>
</div>

<div class="form-card form-card--narrow">
  <h2 class="form-card__heading">Chat API Keys</h2>
  <p class="form-field__hint" style="margin-bottom: 1rem;">
    Bring your own key to chat without limits. Anthropic is used by default;
    if only an OpenAI key is set, OpenAI is used. The demo (no key) is rate-limited to
    <%= LLMResolver::DEMO_DAILY_LIMIT %> messages per day.
  </p>

  <%= form_with(model: @user, html: { autocomplete: "off" }) do |f| %>
    <div class="form-field">
      <%= f.label :anthropic_api_key, "Anthropic API key", class: "form-label" %>
      <p class="form-field__hint form-field__hint--small">
        Status:
        <% if @user.anthropic_api_key.present? %>
          <span class="text-status-set">Set ✓</span>
        <% else %>
          <span class="text-status-unset">Not set</span>
        <% end %>
      </p>
      <%= f.password_field :anthropic_api_key, value: nil, placeholder: "sk-ant-...", class: "form-input" %>
    </div>

    <div class="form-field">
      <%= f.label :openai_api_key, "OpenAI API key", class: "form-label" %>
      <p class="form-field__hint form-field__hint--small">
        Status:
        <% if @user.openai_api_key.present? %>
          <span class="text-status-set">Set ✓</span>
        <% else %>
          <span class="text-status-unset">Not set</span>
        <% end %>
      </p>
      <%= f.password_field :openai_api_key, value: nil, placeholder: "sk-...", class: "form-input" %>
    </div>

    <div>
      <%= f.submit "Save keys", class: "btn btn--full" %>
    </div>
  <% end %>

  <% if @user.anthropic_api_key.present? || @user.openai_api_key.present? %>
    <%= form_with(model: @user, method: :patch) do |f| %>
      <%= f.hidden_field :anthropic_api_key, value: "" %>
      <%= f.hidden_field :openai_api_key, value: "" %>
      <%= f.submit "Remove all keys", class: "btn btn--full btn--danger-soft", data: { turbo_confirm: "Remove your stored API keys?" } %>
    <% end %>
  <% end %>
</div>
