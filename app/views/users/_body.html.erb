<div class="campaign-page">
  <header class="campaign-header">
    <div class="campaign-header__inner">
      <h1 class="campaign-header__title">Campaigns</h1>
      <%= button_to "Create New Campaign", new_campaign_path, method: :get,
        class: "btn" %>
    </div>
  </header>

  <main class="campaign-grid-wrapper">
    <div class="campaign-grid">
      <% current_user.campaigns.each do |campaign| %>
        <div class="campaign-card">
          <%= link_to campaign_pages_path(campaign), class: "campaign-card__main" do %>
            <h2 class="campaign-card__title"><%= campaign.name %></h2>
            <p class="campaign-card__description"><%= campaign.description.presence || "&nbsp;".html_safe %></p>
          <% end %>

          <div class="campaign-card__footer">
            <%= link_to campaign_path(campaign), class: "campaign-card__edit" do %>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="nav-icon nav-icon--sm" style="margin-right: 0.25rem;">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.732-2.732L6 15.268V18h2.732l9.536-9.536a1 1 0 00-1.414-1.414z"/>
              </svg>
              Edit
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </main>
</div>
