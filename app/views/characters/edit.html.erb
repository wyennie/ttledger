<h1 class="character-page__title">Character Sheet: <br><%= @character.name %></h1>
<div>
  <%= render "shared/error_messages", object: @character %>
  <div style="display: flex; margin-bottom: 1rem;">
    <%= link_to "#{@campaign.name}", campaign_path(@campaign.id), class: "btn btn--full btn--dark" %>
  </div>

  <div class="character-sheet">
    <%= form_with model: [@campaign, @character],
      local: false, remote: true,
      data: { controller: "form" } do |f| %>

      <!-- First Row: name, alignment -->
      <div class="character-grid-2">
        <div>
          <%= f.label :name, "Name", class: "form-label" %>
          <%= f.text_field :name, class: "input-text", data: { action: "input->form#submitField" } %>
        </div>
        <div>
          <%= f.label :alignment, "Alignment", class: "form-label" %>
          <%= f.text_field :alignment, class: "input-text", data: { action: "input->form#submitField" } %>
        </div>
      </div>

      <!-- Second Row: class, title, occupation -->
      <div class="character-grid-3">
        <div>
          <%= f.label :character_class, "Class", class: "form-label" %>
          <%= f.text_field :character_class, class: "input-text", data: { action: "input->form#submitField" } %>
        </div>
        <div>
          <%= f.label :title, "Title", class: "form-label" %>
          <%= f.text_field :title, class: "input-text", data: { action: "input->form#submitField" } %>
        </div>
        <div>
          <%= f.label :occupation, "Occupation", class: "form-label" %>
          <%= f.text_field :occupation, class: "input-text", data: { action: "input->form#submitField" } %>
        </div>
      </div>

      <!-- Third Row: level, xp, speed -->
      <div class="character-grid-3">
        <div>
          <%= f.label :level, "Level", class: "form-label" %>
          <%= f.text_field :level, value: @character.level || 0,
            class: "input-text", data: { action: "input->form#submitField" } %>
        </div>
        <div>
          <%= f.label :xp, "XP", class: "form-label" %>
          <%= f.text_field :xp, value: @character.xp || 0,
            class: "input-text", data: { action: "input->form#submitField" } %>
        </div>
        <div>
          <%= f.label :speed, "Speed", class: "form-label" %>
          <%= f.number_field :speed, value: @character.speed || 30,
            class: "input-number", data: { action: "input->form#submitField" } %>
        </div>
      </div>

      <!-- Fourth Row: hp/max_hp, ac -->
      <div class="character-grid-2">

        <!-- HP / Max HP -->
        <div class="character-vitals">
          <%= f.label :current_hp, "Hit Points", class: "character-vitals__label" %>
          <div class="character-hp-row">
            <%= f.number_field :current_hp, value: @character.current_hp || 0,
                class: "input-number", data: { action: "input->form#submitField" } %>
            <span class="character-hp-row__divider">/</span>
            <%= f.number_field :max_hp, value: @character.max_hp || 1,
                class: "input-number", data: { action: "input->form#submitField" } %>
          </div>
        </div>

        <!-- AC -->
        <div class="character-vitals">
          <%= f.label :ac, "AC", class: "character-vitals__label" %>
          <%= f.number_field :ac, value: @character.ac || 10, class: "input-number",
            data: { action: "input->form#submitField" } %>
        </div>
      </div>


      <div class="character-grid-2">
        <!-- Left: Ability Scores -->
        <div class="character-block">
          <h2 class="character-block__title">ABILITY SCORES</h2>
          <% [:strength, :agility, :stamina, :personality, :intelligence, :luck].each do |stat| %>
            <div class="character-ability">
              <%= f.label "current_#{stat}", stat.to_s.capitalize, class: "character-ability__label" %>
              <div class="character-ability__inputs">
                <%= f.number_field "current_#{stat}", value: @character.send("current_#{stat}") || 0,
                  class: "input-number",
                  data: { action: "input->form#submitField" } %>
                <span class="character-ability__divider">/</span>
                <%= f.number_field "max_#{stat}", value: @character.send("max_#{stat}") || 0,
                  class: "input-number",
                  data: { action: "input->form#submitField" } %>
                <div class="character-ability__mod">
                  <%= Character.mod(@character.send("current_#{stat}")) %>
                </div>
              </div>
            </div>
          <% end %>
        </div>

      <!-- Right: Action / Defenses -->
      <div style="display: flex; flex-direction: column; gap: 1.5rem;">
        <div class="character-block character-block--dark" style="display: flex; flex-direction: column; gap: 2rem;">
          <!-- Actions, Crit, Fumble Row -->
          <div class="character-action-grid" style="background: transparent; box-shadow: none; padding: 0;">
            <div>
              <label class="character-action-grid__label">Action</label>
              <%= f.text_field :action_dice, value: @character.action_dice || "d20",
                class: "input-text", data: { action: "input->form#submitField" } %>
            </div>
            <div>
              <label class="character-action-grid__label">Fumble</label>
              <%= f.text_field :fumble_die, value: @character.fumble_die || "d4",
                class: "input-text", data: { action: "input->form#submitField" } %>
            </div>
            <div>
              <label class="character-action-grid__label">Crit</label>
              <%= f.text_field :crit_die, value: @character.crit_die || "d4",
                class: "input-text", data: { action: "input->form#submitField" } %>
            </div>
          </div>

          <div class="character-action-grid" style="background: transparent; box-shadow: none; padding: 0;">
            <div>
              <label class="character-action-grid__label character-action-grid__label--sm">Atk Bns:</label>
            </div>
            <div>
              <%= f.text_field :attack_bonus, value: @character.attack_bonus || 0,
                class: "input-text", data: { action: "input->form#submitField" } %>
            </div>
            <div>
              <%= f.text_field :crit_table, value: @character.crit_table || "Table I",
                class: "input-text", data: { action: "input->form#submitField" } %>
            </div>
          </div>
        </div>


        <!-- Defenses -->
        <div class="character-block character-block--mid">
          <label class="character-defenses-label">DEFENSES</label>
          <div class="character-defenses">
            <div class="character-defense">
              <span class="character-defense__name">Reflex</span>
              <%= f.number_field :reflex, value: @character.reflex || 0,
                class: "input-number", data: { action: "input->form#submitField" } %>
            </div>
            <div class="character-defense">
              <span class="character-defense__name">Fortitude</span>
              <%= f.number_field :fortitude, value: @character.fortitude || 0,
                class: "input-number", data: { action: "input->form#submitField" } %>
            </div>
            <div class="character-defense">
              <span class="character-defense__name">Willpower</span>
              <%= f.number_field :willpower, value: @character.willpower || 0,
                class: "input-number", data: { action: "input->form#submitField" } %>
            </div>
          </div>
        </div>

      </div>
    <% end %>
  </div>

  <!-- Inventory Section -->
  <div class="character-inventory">
    <h2 class="character-inventory__title">Inventory</h2>
    <div class="character-inventory__list">
      <%= turbo_frame_tag "item-modal" do %>
      <% end %>
      <%= turbo_frame_tag "item-list" do %>
        <%= button_to 'Add item', campaign_character_items_path(@campaign, @character),
          method: :post, data: { turbo: true },
          class: "character-inventory__add" %>

        <div>
          <ul style="list-style: none; padding: 0;">
            <% @character.items.each do |item| %>
              <% if item.persisted? %>
                <%= button_to edit_campaign_character_item_path(@campaign, @character, item),
                  method: :get, data: { turbo_frame: "item-modal" },
                  class: "item-row" do %>
                  <span class="item-row__name"><%= item.name %></span>

                  <span class="item-row__meta">
                    <span><%= (item.value || 0).to_s + "gp" %></span>
                    <span><%= item.weight.to_s + " lbs" %></span>
                    <span><%= item.count %> qty</span>
                  </span>

                  <%= link_to "Delete", campaign_character_item_path(@campaign, @character, item),
                    data: {
                      "turbo-method": :delete,
                    }, class: "item-row__delete" %>
                <% end %>
              <% end %>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>

    <br>

    <%= link_to "Delete character", campaign_character_path(@campaign, @character),
      data: { "turbo-method": :delete, turbo_confirm: "Are you sure you want to delete #{@character.name}?" },
      class: "btn btn--full btn--danger" %>
  </div>
</div>
