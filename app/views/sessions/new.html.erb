<div class="auth-frame">
<h1 class="form-page-title">Log in</h1>

<div class="form-card form-card--narrow">
  <%= form_with(url: login_path, scope: :session) do |f| %>
    <div class="form-field">
      <%= f.label :email, class: "form-label" %>
      <%= f.email_field :email, class: "form-input" %>
    </div>

    <div class="form-field">
      <%= f.label :password, class: "form-label" %>
      <%= f.password_field :password, class: "form-input" %>
    </div>

    <div>
      <%= f.submit "Log in", class: "btn btn--full btn--primary" %>
    </div>
  <% end %>

  <p class="login-meta">New User?
    <%= link_to "Sign up now!", signup_path, class: "login-meta__link" %>
  </p>
</div>
</div>
