<!-- app/views/items/edit.html.erb -->
<turbo-frame id="item-modal">
  <div class="item-modal__overlay">
    <div class="item-modal__panel item-modal">
      <h1 class="item-modal__heading">Item Details</h1>

      <%= render "shared/error_messages", object: @item %>

      <%= form_with model: [@campaign, @character, @item], url: campaign_character_item_path(@campaign, @character, @item), method: :patch, data: { turbo: true } do |f| %>

        <div class="form-field">
          <%= f.label :name, "Item Name", class: "form-label form-label--small" %>
          <%= f.text_field :name, class: "form-input" %>
        </div>

        <div class="form-field">
          <%= f.label :description, "Description", class: "form-label form-label--small" %>
          <%= f.text_area :description, class: "form-textarea", rows: 4 %>
        </div>

        <div class="form-field">
          <%= f.label :weight, "Weight (optional)", class: "form-label form-label--small" %>
          <%= f.number_field :weight, class: "form-input" %>
        </div>

        <div class="form-field">
          <%= f.label :value, "Value (optional)", class: "form-label form-label--small" %>
          <%= f.number_field :value, class: "form-input" %>
        </div>

        <div class="form-field">
          <%= f.label :count, "Quantity", class: "form-label form-label--small" %>
          <%= f.number_field :count, class: "form-input" %>
        </div>

        <div class="form-field">
          <%= f.label :item_type, "Item Type", class: "form-label form-label--small" %>
          <%= f.collection_select :item_type_id, ItemType.all, :id, :name, { prompt: "Select Item Type" }, class: "form-select" %>
        </div>

        <div class="form-field">
          <%= f.submit "Save Changes", data: { turbo_frame: "item-modal" }, class: "btn btn--full btn--dark" %>
        </div>

      <% end %>

      <%= link_to "Close", "#", data: { turbo_frame: "item-modal" }, class: "item-modal__close" %>
    </div>
  </div>
</turbo-frame>
