<h1 class="form-page-title">Edit</h1>
<div class="form-card form-card--narrow">
  <%= form_with(model: @campaign) do |f| %>
    <% render "shared/error_messages", object: @campaign %>

    <div class="form-field">
      <%= f.label :name, "Title", class: "form-label" %>
      <%= f.text_field :name, class: "form-input" %>
    </div>

    <div class="form-field">
      <%= f.label :description, class: "form-label" %>
      <%= f.text_area :description, class: "form-textarea" %>
    </div>

    <div>
      <%= f.submit "Save changes", class: "btn btn--full" %>
    </div>
  <% end %>
  <br>
  <%= link_to "DELETE", @campaign, data: { "turbo-method": :delete,
                                           turbo_confirm: "Are you sure you want to delete this campaign?" },
                                   class: "btn btn--full btn--danger" %>
</div>
