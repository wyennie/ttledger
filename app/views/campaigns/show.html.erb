<h1 class="campaign-show__heading"><%= @campaign.name %></h1>

<div class="campaign-show__top">
  <%= link_to "Edit campaign details", edit_campaign_path(@campaign), class: "btn" %>
  <div class="campaign-show__roster">
    <div>
      <p style="font-size: 1.25rem;">
        <strong>Game master:</strong>
        <%= @campaign.roles.find_by(role_type: "gamemaster").user.username %>
      </p>
    </div>
    <div>
      <h3><strong>Players:</strong></h3>
      <ul style="list-style: disc; padding-left: 1.25rem;">
        <% @players.each do |player| %>
          <li><%= player.username %></li>
        <% end %>
      </ul>
    </div>
  </div>
</div>


<% if @campaign.roles.exists?(user: current_user, role_type: :gamemaster) %>
  <h3 style="margin-top: 2rem;">Invite a User</h3>
  <%= form_with url: invite_user_campaign_path(@campaign), method: :post do |f| %>
    <div style="display: flex; align-items: center; gap: 1rem; margin-top: 0.5rem;">
      <div style="flex: 1;">
        <%= text_field_tag :username, nil, placeholder: "Enter user's username", class: "form-input" %>
      </div>
      <%= submit_tag "Send Invitation", class: "btn" %>
    </div>
  <% end %>
<% end %>


<div class="campaign-show__description-block">
  <h2>Description</h2>
  <p>
    <%= @campaign.description.presence || "No description provided" %>
  </p>
</div>

<div>
  <div class="campaign-show__characters-header">
    <h1 class="campaign-show__characters-title">Characters</h1>
    <%= button_to 'Add character', campaign_characters_path(@campaign),
                  method: :post, data: { turbo: true }, params: { character: { name: "Default Name" } },
                  class: "btn" %>
  </div>

  <div id="characters">
    <ul style="list-style: none; padding: 0;">
      <%= render @campaign.characters.reverse %>
    </ul>
  </div>
</div>

