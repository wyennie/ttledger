<%= content_for :title, @campaign.name %>
<div class="app-grid">
  <aside class="app-grid__sidebar">
    <%= render "pages/sidebar" %>
  </aside>

  <main class="app-grid__main">
    <%= render partial: "layouts/flash" %>

<% gm = @campaign.roles.exists?(user: current_user, role_type: :gamemaster) %>
    <div class="page-shell">
      <div class="page-leaf">
        <% if gm %>
          <%= form_with model: @campaign,
                        method: :patch,
                        data: { controller: "editable" },
                        class: "campaign-show__name-form" do |f| %>
            <h1 contenteditable
                data-editable-target="content"
                data-action="keyup->editable#changed"
                data-placeholder="Untitled campaign"
                class="editable campaign-show__heading"><%= @campaign.name %></h1>
            <%= f.hidden_field :name, data: { editable_target: "input" } %>
          <% end %>
        <% else %>
          <h1 class="campaign-show__heading"><%= @campaign.name %></h1>
        <% end %>

        <div class="campaign-show__top">
  <% if gm %>
    <%= link_to "Import a PDF", new_campaign_pdf_import_path(@campaign), class: "btn" %>
  <% end %>
  <div class="campaign-show__roster">
    <div>
      <p style="font-size: 1.25rem;">
        <strong>Game master:</strong>
        <%= @campaign.roles.find_by(role_type: "gamemaster").user.username %>
      </p>
    </div>
    <div>
      <h3><strong>Players:</strong></h3>
      <ul style="list-style: disc; padding-left: 1.25rem;">
        <% @players.each do |player| %>
          <li><%= player.username %></li>
        <% end %>
      </ul>
    </div>
  </div>
</div>


<div class="flourish">❦</div>

<% if gm %>
  <div style="padding: 0 1.5rem;">
    <h3 style="margin-top: 1rem;">Invite a User</h3>
    <%= form_with url: invite_user_campaign_path(@campaign), method: :post do |f| %>
      <div style="display: flex; align-items: center; gap: 1rem; margin-top: 0.5rem;">
        <div style="flex: 1;">
          <%= text_field_tag :username, nil, placeholder: "Enter user's username", class: "form-input" %>
        </div>
        <%= submit_tag "Send Invitation", class: "btn" %>
      </div>
    <% end %>
  </div>
<% end %>

<div class="campaign-show__description-block">
  <h2>Description</h2>
  <% if gm %>
    <%= form_with model: @campaign,
                  method: :patch,
                  data: { controller: "auto-submit-field" } do |f| %>
      <%= f.text_area :description,
                      class: "form-textarea campaign-show__description-field",
                      placeholder: "Tell your players what this campaign is about...",
                      rows: 4,
                      data: { action: "input->auto-submit-field#changed" } %>
    <% end %>
  <% else %>
    <p><%= @campaign.description.presence || "No description provided" %></p>
  <% end %>
</div>

<div class="flourish">❦</div>

<div>
  <div class="campaign-show__characters-header">
    <h1 class="campaign-show__characters-title">Characters</h1>
  </div>

  <div id="characters">
    <ul style="list-style: none; padding: 0;">
      <%= render @campaign.characters.reverse %>
    </ul>
  </div>
</div>

<% if gm %>
  <div class="flourish">❦</div>

  <div class="campaign-show__danger-zone">
    <%= button_to "Delete campaign",
                  campaign_path(@campaign),
                  method: :delete,
                  data: { turbo_confirm: "Permanently delete \"#{@campaign.name}\" and all of its pages, characters, and entities? This cannot be undone." },
                  class: "btn btn--danger" %>
  </div>
<% end %>
      </div>
    </div>
  </main>
</div>
