<div class="page-header">
  <%= form_with model: [@campaign, @page], data: { controller: "editable" } do |f| %>
    <h1 contenteditable
        data-editable-target="content"
        data-action="keyup->editable#changed"
        data-placeholder="untitled"
        class="editable page-title"><%= @page.title %></h1>
    <%= f.hidden_field :title, data: { editable_target: "input" } %>
  <% end %>
</div>
