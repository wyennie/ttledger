<div data-controller="toggle" data-container-id="<%= page.id %>" class="page-node">
  <div class="page-node__row">
    <div class="page-node__label">
      <a
        data-action="click->toggle#toggle"
        data-toggle-target="triangle"
        class="page-node__triangle"
      >
        <%# triangle %>
        <svg id="triangle-<%= page.id %>" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24">
          <path fill="#212121" d="M9 17.898c0 1.074 1.265 1.648 2.073.94l6.31-5.521a1.75 1.75 0 0 0 0-2.634l-6.31-5.522C10.265 4.454 9 5.028 9 6.101v11.797Z"/>
        </svg>
      </a>
      <%= link_to campaign_page_path(page.campaign_id, page.slug) do %>
        <% if page.title.presence %>
          <span class="page-node__title"><%= page.title %></span>
        <% else %>
          <span class="page-node__title page-node__title--untitled"><%= t("untitled") %></span>
        <% end %>
      <% end %>
    </div>

    <div class="page-node__actions">
      <%# minus-circle %>
      <%= link_to campaign_page_path(page.campaign_id, page.slug),
                  data: {
                    "turbo-method": :delete,
                    turbo_confirm: "Deleting this will delete all child pages as well. Delete anyway?"
                  },
                  class: "page-node__action" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="nav-icon nav-icon--sm">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12H9m12 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
        </svg>
      <% end %>
      <%# plus-circle %>
      <%= link_to campaign_pages_path(parent_id: page.id),
                  data: { "turbo-method": :post },
                  class: "page-node__action" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="nav-icon nav-icon--sm">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3m0 0v3m0-3h3m-3 0H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      <% end %>
    </div>
  </div>

  <div id="child-container-<%= page.id %>" data-toggle-target="container" class="page-node__children hidden">
    <% page.children.each do |child| %>
      <%= render "sidebar_child_level_page", page: child %>
    <% end %>
  </div>
</div>
