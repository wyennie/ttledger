<div id="nav-sidebar" class="nav-sidebar">
  <div class="nav-sidebar__sticky">
    <div class="nav-sidebar__inner">
      <div class="nav-sidebar__group">
        <%= link_to user_path(current_user), class: "nav-button" do %>
          <div class="nav-sidebar__user-block">
            <div>
              <svg class="nav-icon nav-icon--sm" fill="currentColor" viewBox="-1 -1 9 11" xmlns="http://www.w3.org/2000/svg">
                <path d="m3.5 0 .488-.57L3.5-.987l-.488.419L3.5 0Zm0 9-.488.57.488.418.488-.419L3.5 9ZM.488 3.57l3.5-3-.976-1.14-3.5 3 .976 1.14Zm2.524-3 3.5 3 .976-1.14-3.5-3L3.012.57Zm-3.5 6 3.5 3 .976-1.14-3.5-3-.976 1.14Zm4.476 3 3.5-3-.976-1.14-3.5 3 .976 1.14Z" />
              </svg>
            </div>
            <div class="nav-sidebar__user-info">
              <span class="nav-sidebar__username">
                <%= @user.username %>
              </span>
              <span class="nav-sidebar__email">
                <%= @user.email %>
              </span>
            </div>
          </div>
        <% end %>

        <%= link_to edit_user_path(current_user), class: "nav-button" do %>
          <svg class="nav-icon nav-icon--sm" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16">
            <path fill="none" d="M0 0h16v16H0z"/>
            <path d="M16 9V7l-2.259-.753a6.01 6.01 0 0 0-.441-1.066l1.066-2.131-1.416-1.416L10.819 2.7a6.324 6.324 0 0 0-1.066-.441L9 0H7l-.753 2.259a6.085 6.085 0 0 0-1.066.441L3.05 1.638 1.638 3.05l1.066 2.131a6.024 6.024 0 0 0-.445 1.066L0 7v2l2.259.753c.112.372.263.728.441 1.066L1.634 12.95l1.416 1.416L5.181 13.3c.338.178.694.328 1.066.441L7 16h2l.753-2.259a6.01 6.01 0 0 0 1.066-.441l2.131 1.066 1.416-1.416-1.066-2.131c.178-.337.328-.694.441-1.066L16 9zm-8 2a3.001 3.001 0 0 1 0-6 3.001 3.001 0 0 1 0 6z"/>
          </svg>
          <span>Settings</span>
        <% end %>

        <%= link_to logout_path, class: "nav-button", data: { "turbo-method": :delete } do %>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="nav-icon">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 9V5.25A2.25 2.25 0 0 1 10.5 3h6a2.25 2.25 0 0 1 2.25 2.25v13.5A2.25 2.25 0 0 1 16.5 21h-6a2.25 2.25 0 0 1-2.25-2.25V15m-3 0-3-3m0 0 3-3m-3 3H15" />
          </svg>
          <span>Log Out</span>
        <% end %>
      </div>

      <%= link_to campaign_path(@campaign), class: "nav-sidebar__campaign-title" do %>
        <%= @campaign.name || "Campaign Title" %>
      <% end %>

      <div class="nav-sidebar__page-tree">
        <% if @top_pages.any? %>
          <% @top_pages.each do |page| %>
            <%= render "pages/sidebar_top_level_page", page: page %>
          <% end %>
        <% else %>
          <div class="nav-sidebar__empty">
            <span class="nav-sidebar__empty-symbol">❦</span>
            <p class="nav-sidebar__empty-text">No pages yet.</p>
            <p class="nav-sidebar__empty-hint">Pen your first below.</p>
          </div>
        <% end %>
      </div>

      <div data-controller="chat" class="nav-sidebar__footer-item">
        <button data-action="click->chat#toggleChat" class="nav-button nav-button--tall toggle-chat-button">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor" class="nav-icon">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 8.511c.884.284 1.5 1.128 1.5 2.097v4.286c0 1.136-.847 2.1-1.98 2.193-.34.027-.68.052-1.02.072v3.091l-3-3c-1.354 0-2.694-.055-4.02-.163a2.115 2.115 0 0 1-.825-.242m9.345-8.334a2.126 2.126 0 0 0-.476-.095 48.64 48.64 0 0 0-8.048 0c-1.131.094-1.976 1.057-1.976 2.192v4.286c0 .837.46 1.58 1.155 1.951m9.345-8.334V6.637c0-1.621-1.152-3.026-2.76-3.235A48.455 48.455 0 0 0 11.25 3c-2.115 0-4.198.137-6.24.402-1.608.209-2.76 1.614-2.76 3.235v6.226c0 1.621 1.152 3.026 2.76 3.235.577.075 1.157.14 1.74.194V21l4.155-4.155" />
          </svg>
          <span>Chat</span>
        </button>
      </div>

      <div class="nav-sidebar__footer-item">
        <%= link_to campaign_entities_path(@campaign), class: "nav-button nav-button--tall" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
          </svg>
          <span>Entities</span>
        <% end %>
      </div>

      <div class="nav-sidebar__footer-item">
        <%= button_to campaign_pages_path(@campaign, parent_id: nil), method: :post, class: "nav-button nav-button--tall" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
          </svg>
          <span>New Page</span>
        <% end %>
      </div>
    </div>
  </div>
</div>
