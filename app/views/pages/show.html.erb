<%= content_for :title, @page.title || "untitled" %>
<div class="app-grid">
  <aside class="app-grid__sidebar">
    <%= render "sidebar" %>
  </aside>

  <main class="app-grid__main">
    <%= render partial: "layouts/flash" %>
    <%= render partial: "shared/chat_form" %>
    <%# render partial: "chats/show" %>

    <div class="page-shell">
      <div class="page-shell__center">
        <%= render "header" %>
      </div>

      <%= form_with model: [@campaign, @page], data: { controller: "tiptap", "tiptap-campaign-id-value": @campaign.id } do |f| %>
        <%= render partial: "body",
                    locals: { initial_content: @page.body,
                              form: f,
                              field_name: :body } %>
      <% end %>
    </div>
  </main>
</div>
