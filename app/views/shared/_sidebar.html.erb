<div id="nav-sidebar" class="nav-sidebar">
  <div class="nav-sidebar__sticky">
    <div class="nav-sidebar__inner">
      <div class="nav-sidebar__group">
        <%= link_to user_path(current_user), class: "nav-button" do %>
          <div class="nav-sidebar__user-block">
            <div>
              <svg class="nav-icon nav-icon--sm" fill="currentColor" viewBox="-1 -1 9 11" xmlns="http://www.w3.org/2000/svg">
                <path d="m3.5 0 .488-.57L3.5-.987l-.488.419L3.5 0Zm0 9-.488.57.488.418.488-.419L3.5 9ZM.488 3.57l3.5-3-.976-1.14-3.5 3 .976 1.14Zm2.524-3 3.5 3 .976-1.14-3.5-3L3.012.57Zm-3.5 6 3.5 3 .976-1.14-3.5-3-.976 1.14Zm4.476 3 3.5-3-.976-1.14-3.5 3 .976 1.14Z" />
              </svg>
            </div>
            <div class="nav-sidebar__user-info">
              <span class="nav-sidebar__username"><%= @user.username %></span>
              <span class="nav-sidebar__email"><%= @user.email %></span>
            </div>
          </div>
        <% end %>

        <%= link_to edit_user_path(current_user), class: "nav-button" do %>
          <svg class="nav-icon nav-icon--sm" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16">
            <path fill="none" d="M0 0h16v16H0z"/>
            <path d="M16 9V7l-2.259-.753a6.01 6.01 0 0 0-.441-1.066l1.066-2.131-1.416-1.416L10.819 2.7a6.324 6.324 0 0 0-1.066-.441L9 0H7l-.753 2.259a6.085 6.085 0 0 0-1.066.441L3.05 1.638 1.638 3.05l1.066 2.131a6.024 6.024 0 0 0-.445 1.066L0 7v2l2.259.753c.112.372.263.728.441 1.066L1.634 12.95l1.416 1.416L5.181 13.3c.338.178.694.328 1.066.441L7 16h2l.753-2.259a6.01 6.01 0 0 0 1.066-.441l2.131 1.066 1.416-1.416-1.066-2.131c.178-.337.328-.694.441-1.066L16 9zm-8 2a3.001 3.001 0 0 1 0-6 3.001 3.001 0 0 1 0 6z"/>
          </svg>
          <span>Settings</span>
        <% end %>

        <%= link_to logout_path, class: "nav-button", data: { "turbo-method": :delete } do %>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="nav-icon">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 9V5.25A2.25 2.25 0 0 1 10.5 3h6a2.25 2.25 0 0 1 2.25 2.25v13.5A2.25 2.25 0 0 1 16.5 21h-6a2.25 2.25 0 0 1-2.25-2.25V15m-3 0-3-3m0 0 3-3m-3 3H15" />
          </svg>
          <span>Log Out</span>
        <% end %>
      </div>

      <div class="nav-sidebar__page-tree"></div>

      <div class="nav-sidebar__footer-item">
        <%= button_to new_campaign_path, method: :get, class: "nav-button nav-button--tall" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
          </svg>
