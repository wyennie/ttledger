<%= content_for :title, "Entity kinds — #{@campaign.name}" %>

<div class="max-w-2xl mx-auto p-6">
  <%= render partial: "layouts/flash" %>

  <div class="flex items-center justify-between mb-6">
    <h1 class="text-3xl font-bold">Entity kinds</h1>
    <%= link_to "Back to entities", campaign_entities_path(@campaign),
        class: "py-2 px-4 font-semibold rounded-lg border border-gray-400 hover:bg-gray-100" %>
  </div>

  <p class="text-gray-700 mb-4">
    Kinds let you group entities (e.g. <code>character</code>, <code>location</code>, <code>faction</code>). Add your own to fit the campaign.
  </p>

  <div class="bg-gray-200 p-6 rounded-lg shadow-lg mb-6">
    <%= form_with(model: [@campaign, @entity_kind], url: campaign_entity_kinds_path(@campaign)) do |f| %>
      <%= render 'shared/error_messages', object: @entity_kind %>
      <div class="flex gap-2 items-end">
        <div class="flex-1">
          <%= f.label :name, "Add a kind", class: "block text-lg font-medium" %>
          <%= f.text_field :name, required: true, placeholder: "e.g. deity",
              class: "mt-1 block w-full p-2 border border-gray-600 rounded-lg focus:ring-gray-300 focus:border-gray-300" %>
        </div>
        <%= f.submit "Add", class: "py-2 px-4 bg-gray-300 font-semibold rounded-lg shadow-md hover:bg-gray-400" %>
      </div>
    <% end %>
  </div>

  <ul class="divide-y border rounded-lg bg-white">
    <% @entity_kinds.each do |kind| %>
      <li class="px-4 py-3 flex items-center justify-between gap-4">
        <%= form_with(model: [@campaign, kind], method: :patch, class: "flex-1 flex gap-2 items-center") do |f| %>
          <%= f.text_field :name, value: kind.name,
              class: "flex-1 p-1 border border-gray-300 rounded focus:border-gray-500" %>
          <%= f.submit "Rename", class: "text-sm py-1 px-2 bg-gray-200 rounded hover:bg-gray-300" %>
        <% end %>
        <span class="text-sm text-gray-600 w-32 text-right">
          <%= pluralize(kind.entities.size, "entity", plural: "entities") %>
        </span>
        <%= button_to "Delete", campaign_entity_kind_path(@campaign, kind),
            method: :delete,
            data: { turbo_confirm: kind.entities.any? ? "This kind is in use and cannot be deleted." : "Delete '#{kind.name}'?" },
            class: "text-sm text-red-700 hover:underline #{'opacity-50' if kind.entities.any?}",
            disabled: kind.entities.any? %>
      </li>
    <% end %>
  </ul>
</div>
